# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 않습니다.

# Supabase 프로젝트 → Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# Supabase 프로젝트 URL (Settings → Data API) — JWT 검증용 공개키(JWKS)를 여기서 받아옴
SUPABASE_URL="https://xxxx.supabase.co"

# OpenAI API 키 (STT/분석/TTS) — 서버에서만 사용, 프론트에 노출 금지
OPENAI_API_KEY="sk-..."

# (선택) 테스트 계정 생성 스크립트(npm run auth:test-user)에만 사용 — 서버 런타임은 쓰지 않음
# Supabase → Project Settings → API Keys → service_role (secret). 모든 권한 키이므로 절대 프론트·커밋 금지
SUPABASE_SERVICE_ROLE_KEY=""

# 서버 설정
PORT=3000
CORS_ORIGIN=http://localhost:5173
